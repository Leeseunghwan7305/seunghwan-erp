#!/usr/bin/env bash
# RAG 검색 품질 게이트 — 통과율이 기준(RAG_EVAL_MIN, 기본 0.8) 미만이면 push를 막는다.
# 커밋된 fixture(backend/eval/rag_fixture.json) 위에서 numpy 코사인만 돌므로 Ollama·DB 불필요.
#
# 활성화(한 번만):  git config core.hooksPath .githooks
# 우회(긴급 시):     git push --no-verify
set -euo pipefail

ROOT="$(git rev-parse --show-toplevel)"
cd "$ROOT/backend"

# 로컬 venv 우선, 없으면 python3
if [ -x "$ROOT/.venv/bin/python" ]; then
  PY="$ROOT/.venv/bin/python"
else
  PY="$(command -v python3 || command -v python || true)"
fi

if [ -z "${PY:-}" ]; then
  echo "⚠️  python을 찾지 못해 RAG eval을 건너뜁니다(push 허용)." >&2
  exit 0
fi

echo "▶ RAG 검색 eval 게이트 실행 중…"
if "$PY" eval/run_rag_eval.py; then
  exit 0
else
  echo "" >&2
  echo "⛔ RAG 검색 통과율이 기준 미만 → push를 막습니다." >&2
  echo "   고친 뒤 다시 push하거나, 의도된 변경이면 fixture/골든을 갱신하세요." >&2
  echo "   (긴급 우회: git push --no-verify)" >&2
  exit 1
fi
