# PostgreSQL
POSTGRES_USER=erp
POSTGRES_PASSWORD=erp
POSTGRES_DB=erp

# Backend
# 시작 시 샘플(시드) 데이터 자동 삽입 여부
SEED_ON_START=true

# Frontend (브라우저에서 호출하는 API 주소 — 호스트 기준)
NEXT_PUBLIC_API_URL=http://localhost:8000

# --- AI 챗봇 ---
# [Claude 연결] CLAUDE_SESSION_KEY가 있으면 구독 쿠키 방식(추가 과금 없음) 우선, 없으면 API 폴백
# (1) 구독 쿠키 방식: claude.ai 로그인 → F12 > Application > Cookies 에서 복사
CLAUDE_SESSION_KEY=
CLAUDE_ORG_ID=
CLAUDE_CF_CLEARANCE=
CLAUDE_CF_BM=
# (2) 공식 API 방식(폴백): console.anthropic.com/settings/keys 에서 발급
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-5
# 로컬 LLM (Ollama). OLLAMA_MODEL은 'ollama list'의 태그와 정확히 일치해야 함(예: qwen2.5:7b, qwen2.5:3b)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b
# RAG 임베딩 모델 (Ollama). 'ollama pull bge-m3'로 설치. dim 1024.
OLLAMA_EMBED_MODEL=bge-m3
